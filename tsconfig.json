{
  "compilerOptions": {
    "incremental": true,
    "noEmit": true,
    "target": "ES2015",
    "module": "ESNext",
    "downlevelIteration": true,
    "strict": true,
    "lib": ["ES2015", "dom", "dom.iterable"],
    "jsx": "preserve",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./client/src/*"],
      "@shared/*": ["./shared/*"]
    }
  }
}
